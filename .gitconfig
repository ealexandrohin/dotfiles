[user]
  name = ealexandrohin
  email = ealexandrohin@gmail.com
  signingkey = ~/.ssh/id_ed25519.pub
[credential]
  helper = store
[core]
  editor = nvim
[init]
  defaultBranch = main
[pull]
  ff = only
[submodule]
  recurse = true

[gpg]
  format = ssh
[commit]
  gpgsign = true
[tag]
  gpgSign = true
[format]
  signOff = true
  signature = @ealexandrohin

[includeIf "gitdir:~/*/**"]
  path = ~/w/.gitconfig
